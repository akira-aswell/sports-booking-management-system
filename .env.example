# Development/demo only. Copy to .env and change passwords for your machine.
POSTGRES_PASSWORD=localdevpassword
JWT_SECRET=CHANGE-THIS-TO-A-UNIQUE-LONG-RANDOM-SECRET-BEFORE-SHARING
DB_HOST_PORT=5433

# New clone: use a new database volume.
DATASAN_DB_VOLUME=datsan-fullstack-pgdata
# Existing legacy volume? Set true when DATASAN_DB_VOLUME points to it.
DATASAN_DB_EXTERNAL=false
